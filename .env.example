# Boshqaruv botining tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# Faqat shu Telegram user ID botdan foydalana oladi (o'zingizning ID'ingiz)
ADMIN_ID=

# Telegram API credentials (my.telegram.org dan olinadi, bitta akkauntda ham ishlatilaveradi)
API_ID=
API_HASH=

# Onix va Tracker akkauntlarining StringSession qatorlari
ONIX_SESSION=
TRACKER_SESSION=

# PostgreSQL ulanish manzili (Railway avtomatik beradi)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Brend va obuna sozlamalari
BOT_BRAND=Milliy Flow | Авто хабарчи
SUBSCRIPTION_PRICE=30 000 so'm
PAYMENT_CARD=5614 6824 1042 4388
PAYMENT_OWNER=R.M
SUBSCRIPTION_DAYS=30

# Ixtiyoriy: sticker file_id
WELCOME_STICKER_ID=

# Ishlash limiti
REST_EVERY_MINUTES=360
REST_DURATION_MINUTES=20
MAX_RUN_MINUTES=720
BROADCAST_CONCURRENCY=30
BROADCAST_RESUME_DELAY_SECONDS=30
BROADCAST_WORKER_ENABLED=true
BROADCAST_WORKER_POLL_SECONDS=1
BROADCAST_LEASE_SECONDS=180
